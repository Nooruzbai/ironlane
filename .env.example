# Copy to .env for local development. Every value is validated by ironlane/config.py.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Production only
ALLOWED_HOSTS=ironlane-freight.com,www.ironlane-freight.com,localhost,127.0.0.1
ENABLE_HTTPS=True
PREPEND_WWW=True

# Leave EMAIL_HOST_USER empty in development to print emails to the console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ironlane-freight.com
INBOX_EMAIL=dispatch@ironlane-freight.com
